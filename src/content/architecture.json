  "debrief": {
    "summary": "Direct browser-to-R2 audio upload, a Postgres job queue and an embedded FastAPI worker drive the voice pipeline.",
    "groups": [
      {
        "title": "01 / Browser & identity",
        "nodes": [
          {
            "id": "web",
            "title": "Debrief PWA",
            "technology": "React / TypeScript · Cloudflare Pages",
            "detail": "Record; poll results; daily / weekly reviews",
            "kind": "frontend"
          },
          {
            "id": "auth",
            "title": "Supabase Auth",
            "technology": "Google OAuth / email code",
            "detail": "Issue the frontend session JWT",
            "kind": "external"
          },
          {
            "id": "turnstile",
            "title": "Cloudflare Turnstile",
            "technology": "Anonymous trial gate",
            "detail": "Verified before upload permission",
            "kind": "external"
          }
        ]
      },
      {
        "title": "02 / FastAPI service · Render · one process",
        "nodes": [
          {
            "id": "api",
            "title": "HTTP API",
            "technology": "FastAPI",
            "detail": "Presign, submit, status and account APIs",
            "kind": "service"
          },
          {
            "id": "worker",
            "title": "Embedded worker",
            "technology": "asyncio task · Postgres queue",
            "detail": "Claim job → Whisper → GPT → save",
            "kind": "process"
          }
        ]
      },
      {
        "title": "03 / Persistent storage",
        "nodes": [
          {
            "id": "db",
            "title": "Application database",
            "technology": "PostgreSQL · SQLAlchemy / asyncpg",
            "detail": "Entries, classifications, jobs and audits",
            "kind": "database"
          },
          {
            "id": "r2",
            "title": "Audio objects",
            "technology": "Cloudflare R2 · S3 API",
            "detail": "Presigned browser PUT; MinIO in local dev",
            "kind": "object"
          }
        ]
      },
      {
        "title": "04 / External model APIs",
        "nodes": [
          {
            "id": "whisper",
            "title": "Transcription",
            "technology": "OpenAI Whisper",
            "detail": "Audio → transcript",
            "kind": "external"
          },
          {
            "id": "gpt",
            "title": "Structured extraction",
            "technology": "OpenAI GPT",
            "detail": "Transcript → categories / todos",
            "kind": "external"
          }
        ]
      }
    ],
    "edges": [
      {
        "from": "web",
        "to": "api",
        "label": "presign / submit / poll / JWT claim",
        "control": false,
        "bidirectional": true
      },
      {
        "from": "web",
        "to": "r2",
        "label": "direct signed PUT",
        "control": false
      },
      {
        "from": "auth",
        "to": "web",
        "label": "sign-in / session JWT",
        "control": true,
        "bidirectional": true
      },
      {
        "from": "api",
        "to": "turnstile",
        "label": "verify trial",
        "control": true
      },
      {
        "from": "api",
        "to": "db",
        "label": "entries / jobs / status",
        "control": false,
        "bidirectional": true
      },
      {
        "from": "worker",
        "to": "db",
        "label": "claim jobs / save results",
        "control": false,
        "bidirectional": true
      },
      {
        "from": "r2",
        "to": "worker",
        "label": "read audio",
        "control": false
      },
      {
        "from": "worker",
        "to": "whisper",
        "label": "audio / transcript",
        "control": false,
        "bidirectional": true
      },
      {
        "from": "worker",
        "to": "gpt",
        "label": "transcript / classifications",
        "control": false,
        "bidirectional": true
      }
    ],
    "note": "FastAPI starts the worker and an hourly TTL sweep in the same process. The Postgres queue uses SELECT FOR UPDATE SKIP LOCKED; there is no broker. Anonymous clients poll status and audio expires after 24 hours; signed-in notifications use Supabase Realtime."
  }
