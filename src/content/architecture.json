{
  "el-nino-commodities": {
    "summary": "Python research pipelines, timestamped file storage and a static HTML/JS workbench.",
    "groups": [
      {
        "title": "01 / Sources & scheduling",
        "nodes": [
          {
            "id": "sources",
            "title": "Climate & crop sources",
            "technology": "NOAA · CHIRPS · MPOB · World Bank",
            "detail": "Climate, rainfall, supply and prices",
            "kind": "external"
          },
          {
            "id": "actions",
            "title": "GitHub Actions",
            "technology": "Weekly scheduler",
            "detail": "Starts the weekly pipeline",
            "kind": "external"
          }
        ]
      },
      {
        "title": "02 / Ingestion & persistence",
        "nodes": [
          {
            "id": "ingest",
            "title": "climcomm fetchers",
            "technology": "Python",
            "detail": "Fetch and timestamp source releases",
            "kind": "process"
          },
          {
            "id": "archive",
            "title": "Local archive",
            "technology": "Files + manifest.jsonl",
            "detail": "SHA-256, issued_at, ingested_at",
            "kind": "files"
          },
          {
            "id": "r2",
            "title": "Private archive backup",
            "technology": "Cloudflare R2 · S3 API",
            "detail": "Whitelisted, hash-verified sync",
            "kind": "object"
          }
        ]
      },
      {
        "title": "03 / Research & monitoring",
        "nodes": [
          {
            "id": "research",
            "title": "Frozen research",
            "technology": "Python · point-in-time selection",
            "detail": "Historical tests and whole-event holdouts",
            "kind": "process"
          },
          {
            "id": "monitor",
            "title": "Weekly monitoring",
            "technology": "Python · forward evidence",
            "detail": "New observations; append-only log",
            "kind": "process"
          },
          {
            "id": "reports",
            "title": "Committed outputs",
            "technology": "Reports + display snapshots",
            "detail": "Frozen results and weekly reports",
            "kind": "files"
          }
        ]
      },
      {
        "title": "04 / Publication & frontend",
        "nodes": [
          {
            "id": "export",
            "title": "Static export",
            "technology": "Python build + safety scan",
            "detail": "Exclude raw files and vendor quotes",
            "kind": "process"
          },
          {
            "id": "web",
            "title": "Research workbench",
            "technology": "HTML / JavaScript · Cloudflare Pages",
            "detail": "Browser reads exported evidence",
            "kind": "frontend"
          }
        ]
      }
    ],
    "edges": [
      {
        "from": "sources",
        "to": "ingest",
        "label": "fetch",
        "control": false
      },
      {
        "from": "actions",
        "to": "ingest",
        "label": "weekly trigger",
        "control": true
      },
      {
        "from": "ingest",
        "to": "archive",
        "label": "append versions",
        "control": false
      },
      {
        "from": "archive",
        "to": "r2",
        "label": "sync approved files",
        "control": false
      },
      {
        "from": "archive",
        "to": "research",
        "label": "as-of inputs",
        "control": false
      },
      {
        "from": "archive",
        "to": "monitor",
        "label": "latest observations",
        "control": false
      },
      {
        "from": "research",
        "to": "reports",
        "label": "frozen results",
        "control": false
      },
      {
        "from": "monitor",
        "to": "reports",
        "label": "weekly reports",
        "control": false
      },
      {
        "from": "reports",
        "to": "export",
        "label": "read committed outputs",
        "control": false
      },
      {
        "from": "export",
        "to": "web",
        "label": "static assets",
        "control": false
      }
    ],
    "note": "The archive is file-based, not a SQL database. R2 preserves private raw data; the browser has no live research API and does not rerun models."
  },
  "churchmap": {
